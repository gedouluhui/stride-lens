include LICENSE README.md pyproject.toml MANIFEST.in
include scripts/verify.py scripts/check_sdist.py
include docs/demo.html docs/demo.json
recursive-include src/stridelens *.py *.html
recursive-include tests *.py
prune artifacts
prune .git
prune .venv
prune docs/superpowers
global-exclude __pycache__ *.py[cod]
